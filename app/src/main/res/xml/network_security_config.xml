<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Chromecast must fetch local files over the phone's temporary LAN HTTP stream. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
